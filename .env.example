# Copy to .env and fill in. Generate secrets as shown in the README
PUBLIC_URL=https://wa.example.com      # public HTTPS origin of the bridge (no trailing slash)
OWNER_NAME=Alex                        # how the model and consent page refer to you

OWNER_PASSWORD_SHA256=                 # sha256 hex of the password you type on the OAuth consent page
WAHA_API_KEY=                          # random string; the bridge sends it to WAHA
WAHA_API_KEY_HASH=                     # sha512:<sha512 hex of WAHA_API_KEY>; WAHA stores only the hash
WAHA_WEBHOOK_HMAC=                     # random string; signs WAHA -> bridge webhooks
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=               # for QR pairing via SSH tunnel

# Scope. "*" = every personal chat (groups, status, channels never match).
ALLOWED_CHATS=*
SEND_CHATS=*                           # "*" = existing dialogs only, unless SEND_NEW_CHATS=true
SEND_ENABLED=true
SEND_NEW_CHATS=false
SEND_DAILY_CAP=30
RETENTION_DAYS=30
OAUTH_REDIRECT_PREFIXES=https://chatgpt.com/   # comma-separated; add https://claude.ai/ for Claude
